#!/usr/bin/env bash
# Rebuild and restart Chess (chess_app) from this checkout, then wait until it answers.
# Migrations: run at startup by the app (scripts/container_startup.py → alembic upgrade head).
# Since that writes data/chess.db, the DB is snapshotted to data/backups/ first (newest 10 kept).
set -euo pipefail
cd "$(dirname "$0")"

if [ -f data/chess.db ]; then
    mkdir -p data/backups
    snap="data/backups/deploy-$(date +%Y%m%d-%H%M%S).db"
    python3 - "$snap" <<'EOF'
import sqlite3, sys
src = sqlite3.connect("file:data/chess.db?mode=ro", uri=True)
dst = sqlite3.connect(sys.argv[1])
src.backup(dst)
dst.close(); src.close()
EOF
    echo "deploy: chess.db snapshot → $snap"
    ls -1t data/backups/deploy-*.db | tail -n +11 | xargs -r rm --
fi

docker compose up -d --build chess

for _ in $(seq 1 45); do
    if [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 localhost:8011/health)" = 200 ]; then
        echo "deploy: chess up on :8011 ($(cat version.txt 2>/dev/null || echo 'no version'))"
        exit 0
    fi
    sleep 2
done
echo "deploy: chess did not answer 200 on :8011/health within 90 s" >&2
docker logs --tail 20 chess_app >&2 || true
exit 1
